name: CHAMPS LAB daily statistics
on:
  schedule:
    - cron: '30 2 * * *' # 11:30 Asia/Seoul. GitHub can delay scheduled jobs.
  workflow_dispatch:
permissions:
  contents: write
  pages: write
  id-token: write
concurrency:
  group: champs-statistics
  cancel-in-progress: false
jobs:
  update:
    runs-on: ubuntu-latest
    timeout-minutes: 120
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - run: node automation/sync-stats.mjs public/stats-feed.json
      - name: Preserve last good feed in repository
        run: |
          git config user.name "CHAMPS LAB statistics"
          git config user.email "stats@users.noreply.github.com"
          git add public/stats-feed.json
          git diff --cached --quiet || git commit -m "Update validated singles statistics"
          git push
      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v3
        with:
          path: public
      - uses: actions/deploy-pages@v4
